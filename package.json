{
  "name": "terminal-playlist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next node_modules/.cache && next dev --turbo --hostname localhost --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "auth:refresh": "curl -sf -X POST \"${NEXT_PUBLIC_BASE_URL:-http://localhost:3000}/api/auth/refresh\" && echo 'token refresh ok' || echo 'token refresh failed — visit /login to re-authenticate'"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "next": "^14.2.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6"
  }
}
